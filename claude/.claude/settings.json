{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0",
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "0",
    "CLAUDE_CODE_DISABLE_MOUSE": "0",
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "0",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_IN_BWRAP\" ] || { echo \"Not running inside bwrap\" >&2; exit 2; }"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup mpv --no-config --no-video --no-terminal --really-quiet --load-scripts=no --ytdl=no --audio-display=no --volume=100 ~/.claude/sounds/mixkit-message-pop-alert-2354.mp3 >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "extraKnownMarketplaces": {
    "sage": {
      "source": {
        "source": "git",
        "url": "https://github.com/gendigitalinc/sage.git"
      },
      "autoUpdate": false
    }
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Working"
    ]
  },
  "alwaysThinkingEnabled": true,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "stable",
  "prefersReducedMotion": true,
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "enabledPlugins": {
    "sage@sage": true
  },
  "diffSidebarOpen": false
}
